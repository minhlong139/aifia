# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Vnstock
VNSTOCK_API_KEY=  # Optional - for sponsor tier

# OpenClaw - Webhook trigger
OPENCLAW_WEBHOOK_URL=
OPENCLAW_WEBHOOK_SECRET=

# AI Provider (for financial analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_TIMEOUT_MS=35000

# AI chat vector retrieval (Supabase RPC)
ENABLE_VECTOR_RAG=true
SUPABASE_VECTOR_RPC=match_documents
VECTOR_MATCH_COUNT=8
VECTOR_MATCH_THRESHOLD=0.70
# or
ANTHROPIC_API_KEY=
